#!/usr/bin/env bash
# rode: open rscode from the terminal, the way `code` opens VS Code (ADR-0110).
#
#   rode [options] [folder] [file ...]
#
#   rode                open the current folder
#   rode ~/dev/proj     open a folder
#   rode src/main.rs    open a file (its folder becomes the workspace)
#   rode . README.md    open the current folder and a file in it
#   rode -g src/main.rs:12:3   open a file with the caret at line 12, column 3
#
# Options:
#   -w, --wait      stay attached: logs in this terminal, return when the window closes
#   -g, --goto      file arguments may end in :line[:column] (like code -g)
#   -v, --version   print the installed version
#   -h, --help      print this help
#   --dry-run       print what would run, start nothing
#
# Without --wait the app runs detached; its log is in $TMPDIR/rscode/rode.log.
# Installed by scripts/install-rode (app in ~/Applications/rscode.app, `rode` in ~/.local/bin).
# Run that again after pulling new changes to update the installed app.
set -euo pipefail

# Follow the ~/.local/bin/rode symlink back into the bundle (Contents/Resources/bin/rode).
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  if [[ "$link" = /* ]]; then self="$link"; else self="$(dirname "$self")/$link"; fi
done
here="$(cd "$(dirname "$self")" && pwd)"
app="${RODE_APP:-$(cd "$here/../../.." && pwd)}"
bin="$app/Contents/MacOS/rscode"
env_file="$app/Contents/Resources/rode.env"

RODE_VERSION=unknown
# Defaults written at install time (Code-OSS host, Node). Each only applies when the variable is
# unset in your shell. Your ~/.vscode/extensions load; `RSCODE_EXTENSIONS_DIR= rode .` turns them off.
# shellcheck source=/dev/null
[[ -f "$env_file" ]] && source "$env_file"

wait=0
dry=0
paths=()
for a in "$@"; do
  case "$a" in
    -w|--wait) wait=1 ;;
    -g|--goto) paths+=("$a") ;; # rscode reads the :line[:column] of the file arguments
    --dry-run) dry=1 ;;
    -v|--version) echo "rode $RODE_VERSION"; exit 0 ;;
    -h|--help) sed -n '2,21p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "rode: unknown option $a (see rode --help)" >&2; exit 2 ;;
    *) paths+=("$a") ;;
  esac
done

if [[ ! -x "$bin" ]]; then
  echo "rode: rscode is not installed at $app (run scripts/install-rode in the rscode repo)" >&2
  exit 1
fi

if [[ $dry -eq 1 ]]; then
  echo "cwd: $PWD"
  echo "bin: $bin"
  echo "wait: $wait"
  for p in ${paths[@]+"${paths[@]}"}; do echo "arg: $p"; done
  for v in RSCODE_CODE_OSS RSCODE_NODE RSCODE_EXTENSIONS_DIR; do
    if [[ -n "${!v+set}" ]]; then echo "env: $v=${!v}"; fi
  done
  exit 0
fi

# Paths are passed as typed; rscode resolves them against this directory (it inherits the cwd).
if [[ $wait -eq 1 ]]; then
  exec "$bin" ${paths[@]+"${paths[@]}"}
fi
log_dir="${TMPDIR:-/tmp}/rscode"
mkdir -p "$log_dir"
nohup "$bin" ${paths[@]+"${paths[@]}"} >"$log_dir/rode.log" 2>&1 &
disown
