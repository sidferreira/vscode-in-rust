# ---------------------------------------------------------------- output

def write_outputs(data):
    with open(HTML_OUT, "w", encoding="utf-8") as fh:
        fh.write(render(data))
    with open(HISTORY, "w", encoding="utf-8") as fh:
        json.dump(data["history"], fh, indent=2)
        fh.write("\n")


def main(argv=None):
    p = argparse.ArgumentParser(prog="progress-report", description=__doc__.split("\n\n")[0])
    p.add_argument("--clone", help="upstream clone for settings-port and test-port "
                   "(default: [upstream].clone from upstream/ports.toml, against the repo root)")
    p.add_argument("--with-tests", action="store_true",
                   help="run cargo test --workspace and record the passing count (slow; default off)")
    args = p.parse_args(argv)
    data = collect(args)
    write_outputs(data)
    s = data["snapshot"]
    print("wrote %s and %s" % (os.path.relpath(HTML_OUT, REPO_ROOT),
                                os.path.relpath(HISTORY, REPO_ROOT)))
    print("sha %s, settings wired %s, tests ported %s / %s, scenarios ready %s / %s, rust tests %s"
          % (data["git"]["sha"], num(s["settings_wired"]), num(s["tests_ported"]), num(s["tests_total"]),
             num(s["scenarios_ready"]), num(s["scenarios_total"]), num(s["rust_tests_passing"])))
    for n in data["notices"]:
        print("note: " + n, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
