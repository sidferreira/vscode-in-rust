#!/usr/bin/env python3
"""gen-rpc-ids: generate the extension host RPC proxy id table from upstream VS Code.

Reads `MainContext` and `ExtHostContext` of `src/vs/workbench/api/common/extHost.protocol.ts` and
writes `crates/vsr-rpc/src/proxy_ids.rs`. Upstream numbers a proxy by construction order:
`ProxyIdentifier.nid = ++ProxyIdentifier.count` (`proxyIdentifier.ts`), so the id of a shape is its
1-based position among the `createProxyIdentifier(...)` calls, `MainContext` first, then
`ExtHostContext`. The wire carries the id as one byte (`rpcId` in `rpcProtocol.ts`).

    scripts/gen-rpc-ids [--clone PATH] [--check]

Fails (exit 1) when the file has `createProxyIdentifier` calls outside the two contexts, when an id
passes 255, or when a name repeats: any of those would make the numbering differ from upstream's.
`--check` fails when the checked-in file is out of date. Stdlib only, Python >= 3.8.
"""

import argparse
import os
import re
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT = os.path.dirname(SCRIPT_DIR)
OUT = os.path.join(REPO_ROOT, "crates", "vsr-rpc", "src", "proxy_ids.rs")
SOURCE = "src/vs/workbench/api/common/extHost.protocol.ts"
DEFAULT_CLONE = os.environ.get("UPSTREAM_CLONE") or os.path.join(REPO_ROOT, "..", "vscode-original")

CALL_RE = re.compile(r"createProxyIdentifier\s*<[^>]*>\s*\(\s*'([A-Za-z0-9_]+)'\s*\)")
BLOCK_RE = r"export const %s = \{\n(.*?)\n\};"


def read_source(clone):
    path = os.path.join(clone, SOURCE)
    with open(path, encoding="utf-8") as f:
        return f.read()


def pinned_sha(clone):
    try:
        out = subprocess.run(["git", "-C", clone, "rev-parse", "HEAD"], capture_output=True, text=True, check=True)
        return out.stdout.strip()[:12]
    except Exception:
        return "unknown"


def parse(text):
    blocks = {}
    for name in ("MainContext", "ExtHostContext"):
        m = re.search(BLOCK_RE % name, text, re.S)
        if not m:
            sys.exit("gen-rpc-ids: cannot find `export const %s = {...};`" % name)
        entries = []
        for line in m.group(1).splitlines():
            line = line.strip()
            if not line:
                continue
            c = CALL_RE.search(line)
            km = re.match(r"([A-Za-z0-9_]+):", line)
            if not c or not km:
                sys.exit("gen-rpc-ids: unrecognised line in %s: %r" % (name, line))
            entries.append((km.group(1), c.group(1)))  # (object key, string id)
        blocks[name] = entries
    total = len(CALL_RE.findall(text))
    found = sum(len(v) for v in blocks.values())
    if total != found:
        sys.exit("gen-rpc-ids: %d createProxyIdentifier calls but %d inside the two contexts: "
                 "the numbering would differ from upstream" % (total, found))
    names = [k for ctx in blocks.values() for k, _ in ctx]
    sids = [s for ctx in blocks.values() for _, s in ctx]
    if len(set(names)) != len(names) or len(set(sids)) != len(sids):
        sys.exit("gen-rpc-ids: duplicate proxy names")
    if len(names) > 255:
        sys.exit("gen-rpc-ids: more than 255 proxies; the wire id is one byte")
    return blocks


def const_name(name):
    return re.sub(r"(?<=[a-z0-9])(?=[A-Z])", "_", name).upper()


def render(blocks, sha):
    out = []
    w = out.append
    w("//! Extension host RPC proxy ids. GENERATED by `scripts/gen-rpc-ids`; do not edit.")
    w("//!")
    w("//! upstream: %s @ %s" % (SOURCE, sha))
    w("//!")
    w("//! Upstream numbers a proxy by construction order (`ProxyIdentifier.nid`): `MainContext` first,")
    w("//! then `ExtHostContext`, starting at 1. The id travels as one byte in a request.")
    w("")
    w("#![cfg_attr(rustfmt, rustfmt::skip)]")
    w("")
    n = 0
    tables = {}
    for ctx, mod in (("MainContext", "main"), ("ExtHostContext", "ext_host")):
        rows = []
        w("/// Shapes the extension host calls on the main thread (`MainContext`).") if mod == "main" else \
            w("/// Shapes the main thread calls on the extension host (`ExtHostContext`).")
        w("pub mod %s {" % mod)
        for key, sid in blocks[ctx]:
            n += 1
            rows.append((sid, n))
            w("    pub const %s: u8 = %d;" % (const_name(key), n))
        w("")
        w("    /// `(name, id)` in id order.")
        w("    pub const ALL: [(&str, u8); %d] = [" % len(rows))
        for name, i in rows:
            w('        ("%s", %d),' % (name, i))
        w("    ];")
        w("}")
        w("")
        tables[mod] = rows
    w("/// The string id (`ProxyIdentifier.sid`) of a proxy id, in either direction.")
    w("pub fn name_of(id: u8) -> Option<&'static str> {")
    w("    main::ALL.iter().chain(ext_host::ALL.iter()).find(|(_, i)| *i == id).map(|(n, _)| *n)")
    w("}")
    w("")
    w("/// The id of a string id (`ProxyIdentifier.sid`).")
    w("pub fn id_of(name: &str) -> Option<u8> {")
    w("    main::ALL.iter().chain(ext_host::ALL.iter()).find(|(n, _)| *n == name).map(|(_, i)| *i)")
    w("}")
    w("")
    w("/// True when `id` is a `MainContext` shape (a request the extension host sends us).")
    w("pub fn is_main(id: u8) -> bool {")
    w("    (1..=main::ALL.len() as u8).contains(&id)")
    w("}")
    return "\n".join(out) + "\n"


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("--clone", default=DEFAULT_CLONE)
    p.add_argument("--check", action="store_true")
    args = p.parse_args()
    text = render(parse(read_source(args.clone)), pinned_sha(args.clone))
    if args.check:
        try:
            cur = open(OUT, encoding="utf-8").read()
        except FileNotFoundError:
            cur = ""
        if cur != text:
            sys.exit("gen-rpc-ids: %s is out of date" % os.path.relpath(OUT, REPO_ROOT))
        print("gen-rpc-ids: up to date")
        return
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as f:
        f.write(text)
    print("gen-rpc-ids: wrote %s" % os.path.relpath(OUT, REPO_ROOT))


if __name__ == "__main__":
    main()
